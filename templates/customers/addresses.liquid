{% comment %} Stub — real addresses template (add/edit forms) comes later. {% endcomment %}
<div class="container">
  <h1>Addresses</h1>
  <ul>
    {% for address in customer.addresses %}
      <li>{{ address | format_address }}</li>
    {% else %}
      <li>No addresses saved.</li>
    {% endfor %}
  </ul>
  <p><a href="{{ routes.account_url }}">Back to account</a></p>
</div>
