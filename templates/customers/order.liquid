{% comment %} Stub — real order template comes later. {% endcomment %}
<div class="container">
  <h1>Order {{ order.name }}</h1>
  <p>{{ order.created_at | date: '%B %d, %Y' }}</p>
  <ul>
    {% for line_item in order.line_items %}
      <li>{{ line_item.title }} — {{ line_item.quantity }} × {{ line_item.final_price | money }}</li>
    {% endfor %}
  </ul>
  <p>Total: {{ order.total_price | money }}</p>
  <p><a href="{{ routes.account_url }}">Back to account</a></p>
</div>
