{% comment %} Stub — real reset-password template comes later. {% endcomment %}
<div class="container">
  <h1>Reset Password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="New password" autocomplete="new-password" required>
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" autocomplete="new-password" required>
    <button type="submit" class="btn-green">Reset Password</button>
  {% endform %}
</div>
