{% comment %}
  Contact page — native rebuild of the SuiteCommerce
  contact-us-landing-page template (audit/pages/contact-us.json; visual
  source of truth is audit/screenshots/contact-us.png). Left-aligned
  italic "Contact Us" title, then four equal columns — Phone / Email Us /
  Fax Us / Headquarters — each an icon above a bold heading and centered
  detail text, separated by full-height vertical rules.

  Columns are schema blocks (icon + heading + rich-text detail) so they
  are editable in the theme editor; the real captured content ships in
  templates/page.contact.json. Stacks to one column below 768px.
{% endcomment %}

<div class="container">
  {% render 'breadcrumbs' %}

  <div class="contact">
    <h1 class="contact-title">{{ page.title }}</h1>

    {%- if section.blocks.size > 0 -%}
      <ul class="contact-cols">
        {%- for block in section.blocks -%}
          <li class="contact-col" {{ block.shopify_attributes }}>
            <svg class="contact-icon" aria-hidden="true"><use href="#i-{{ block.settings.icon }}"/></svg>
            <h2 class="contact-heading">{{ block.settings.heading }}</h2>
            <div class="contact-detail">{{ block.settings.detail }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact page",
  "settings": [],
  "blocks": [
    {
      "type": "column",
      "name": "Info column",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "phone", "label": "Phone handset" },
            { "value": "envelope", "label": "Envelope" },
            { "value": "fax", "label": "Documents (fax)" },
            { "value": "building", "label": "Building" }
          ],
          "default": "phone"
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "detail", "label": "Detail" }
      ]
    }
  ]
}
{% endschema %}
