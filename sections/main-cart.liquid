{% comment %}
  Shopping cart page — full rebuild, replacing the earlier stub. Layout
  follows the reference cart page Min supplied: image + title/price/qty/
  amount per line with Save-for-Later/Remove actions, a right-hand Order
  Summary box (subtotal, shipping estimate, promo code, checkout button),
  and Recently Viewed / Saved For Later below.

  Platform notes (confirmed with Min 2026-09-21):
  - "Quick Add" dropdown: skipped, not needed right now.
  - Shipping estimate is real — Shopify's native /cart/shipping_rates.json,
    no app needed. Tax is NOT computed here: Shopify only calculates tax
    once the customer reaches checkout, so the panel says so instead of
    showing a number.
  - Promo code: the code is carried to the checkout URL (?discount=...)
    and only validated once checkout loads — this page can't confirm a
    code is valid up front, Min's OK with that.
  - Save for Later is browser-only (localStorage), not a real account
    feature — it resets if the customer switches device/browser or
    clears site data. No login/account system exists on the site right
    now (removed earlier at Min's request).
  - "Edit" link intentionally left out: every current product is single-
    variant, so there is nothing to edit yet. Add it back next to Remove
    if a multi-variant product is ever added.

  All cart mutations (qty change / remove / save-for-later) call
  Shopify's /cart/change.js and then reload the page — the simplest,
  least error-prone way to keep line numbers in sync (line positions
  shift when a line is removed). See the "Cart page" block in akdy.js.
{% endcomment %}

<div class="container">
  {% render 'breadcrumbs' %}

  <div class="cart-header">
    <h1 class="cart-title">
      {{ section.settings.title }}
      <span class="cart-title-count">
        ({{ cart.items.size }} {% if cart.items.size == 1 %}{{ section.settings.product_singular }}{% else %}{{ section.settings.product_plural }}{% endif %}, {{ cart.item_count }} {% if cart.item_count == 1 %}{{ section.settings.item_singular }}{% else %}{{ section.settings.item_plural }}{% endif %})
      </span>
    </h1>
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-layout">
      <div class="cart-items-col">
        <div class="cart-items">
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item-media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 300 | image_tag: alt: item.title, loading: 'lazy' }}
                {%- else -%}
                  {% render 'image-placeholder' %}
                {%- endif -%}
              </a>
              <div class="cart-item-info">
                <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <p class="cart-item-variant">{{ item.variant.title }}</p>
                {%- endif -%}
                <p class="cart-item-price">{{ item.final_price | money }}</p>

                <div class="cart-item-qty">
                  <label for="cart-qty-{{ forloop.index }}">{{ section.settings.qty_label }}</label>
                  <input
                    type="number"
                    id="cart-qty-{{ forloop.index }}"
                    class="cart-qty-input"
                    value="{{ item.quantity }}"
                    min="1"
                    data-line="{{ forloop.index }}"
                  >
                </div>

                <p class="cart-item-amount">{{ section.settings.amount_label }} <strong>{{ item.final_line_price | money }}</strong></p>
                <p class="cart-item-error" hidden></p>

                <div class="cart-item-actions">
                  <button
                    type="button"
                    class="cart-save-for-later"
                    data-line="{{ forloop.index }}"
                    data-variant-id="{{ item.variant_id }}"
                    data-title="{{ item.product.title | escape }}"
                    data-variant-title="{{ item.variant.title | escape }}"
                    data-price="{{ item.final_price }}"
                    data-url="{{ item.url | escape }}"
                    data-image="{{ item.image | image_url: width: 300 }}"
                  >{{ section.settings.save_for_later_label }}</button>
                  <span class="cart-item-divider">|</span>
                  <button type="button" class="cart-remove" data-line="{{ forloop.index }}">{{ section.settings.remove_label }}</button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="cart-summary-col">
        <div class="order-summary">
          <h2>{{ section.settings.summary_heading }}</h2>
          <div class="summary-row summary-subtotal">
            <span>{{ section.settings.subtotal_label }} {{ cart.item_count }} {% if cart.item_count == 1 %}{{ section.settings.item_singular }}{% else %}{{ section.settings.item_plural }}{% endif %}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="summary-note">{{ section.settings.subtotal_note }}</p>

          <div class="summary-collapse" id="shipping-estimator">
            <button type="button" class="summary-collapse-toggle" aria-expanded="false" aria-controls="shipping-estimator-panel">
              <span>{{ section.settings.shipping_label }}</span>
              <svg aria-hidden="true" class="summary-collapse-chevron"><use href="#i-chevron-down"/></svg>
            </button>
            <div class="summary-collapse-panel" id="shipping-estimator-panel" hidden>
              <p class="summary-fine-print">{{ section.settings.shipping_note }}</p>
              <label for="ship-zip">{{ section.settings.zip_label }}</label>
              <input type="text" id="ship-zip" inputmode="numeric" maxlength="10" autocomplete="postal-code">
              <label for="ship-state">{{ section.settings.state_label }}</label>
              <select id="ship-state" autocomplete="address-level1">
                <option value="">{{ section.settings.state_placeholder }}</option>
                <option value="AL">Alabama</option>
                <option value="AZ">Arizona</option>
                <option value="AR">Arkansas</option>
                <option value="CA">California</option>
                <option value="CO">Colorado</option>
                <option value="CT">Connecticut</option>
                <option value="DE">Delaware</option>
                <option value="DC">District of Columbia</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
                <option value="ID">Idaho</option>
                <option value="IL">Illinois</option>
                <option value="IN">Indiana</option>
                <option value="IA">Iowa</option>
                <option value="KS">Kansas</option>
                <option value="KY">Kentucky</option>
                <option value="LA">Louisiana</option>
                <option value="ME">Maine</option>
                <option value="MD">Maryland</option>
                <option value="MA">Massachusetts</option>
                <option value="MI">Michigan</option>
                <option value="MN">Minnesota</option>
                <option value="MS">Mississippi</option>
                <option value="MO">Missouri</option>
                <option value="MT">Montana</option>
                <option value="NE">Nebraska</option>
                <option value="NV">Nevada</option>
                <option value="NH">New Hampshire</option>
                <option value="NJ">New Jersey</option>
                <option value="NM">New Mexico</option>
                <option value="NY">New York</option>
                <option value="NC">North Carolina</option>
                <option value="ND">North Dakota</option>
                <option value="OH">Ohio</option>
                <option value="OK">Oklahoma</option>
                <option value="OR">Oregon</option>
                <option value="PA">Pennsylvania</option>
                <option value="RI">Rhode Island</option>
                <option value="SC">South Carolina</option>
                <option value="SD">South Dakota</option>
                <option value="TN">Tennessee</option>
                <option value="TX">Texas</option>
                <option value="UT">Utah</option>
                <option value="VT">Vermont</option>
                <option value="VA">Virginia</option>
                <option value="WA">Washington</option>
                <option value="WV">West Virginia</option>
                <option value="WI">Wisconsin</option>
                <option value="WY">Wyoming</option>
              </select>
              <button type="button" id="ship-estimate-btn" class="btn-outline">{{ section.settings.shipping_button_label }}</button>
              <div id="ship-results" class="ship-results"></div>
              <p class="summary-fine-print">{{ section.settings.tax_note }}</p>
            </div>
          </div>

          <div class="summary-collapse" id="promo-code">
            <button type="button" class="summary-collapse-toggle" aria-expanded="false" aria-controls="promo-code-panel">
              <span>{{ section.settings.promo_label }}</span>
              <svg aria-hidden="true" class="summary-collapse-chevron"><use href="#i-chevron-down"/></svg>
            </button>
            <div class="summary-collapse-panel" id="promo-code-panel" hidden>
              <label for="promo-code-input" class="sr-only">{{ section.settings.promo_label }}</label>
              <input type="text" id="promo-code-input" placeholder="{{ section.settings.promo_placeholder }}" autocomplete="off">
              <p class="summary-fine-print">{{ section.settings.promo_note }}</p>
            </div>
          </div>

          <a href="{{ routes.checkout_url }}" id="cart-checkout-link" class="btn-green cart-checkout-btn">{{ section.settings.checkout_label }}</a>
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="cart-empty">
      <p>{{ section.settings.empty_message }}</p>
      <a class="btn-green" href="{{ routes.root_url }}">{{ section.settings.continue_shopping_label }}</a>
    </div>
  {%- endif -%}

  {%- comment -%}
    Both sections below are empty shells filled in by akdy.js from
    localStorage — nothing server-side to render, and both stay hidden
    (see the `hidden` attribute) until JS finds something to show.
  {%- endcomment -%}
  <div class="cart-saved-items" id="saved-items-section" hidden>
    <h2>{{ section.settings.saved_heading }}</h2>
    <ul class="product-grid" id="saved-items-grid"></ul>
  </div>

  <div class="cart-recently-viewed" id="recently-viewed-section" hidden>
    <h2>{{ section.settings.recently_viewed_heading }}</h2>
    <ul class="product-grid" id="recently-viewed-grid"></ul>
  </div>
</div>

{% schema %}
{
  "name": "Shopping cart",
  "settings": [
    { "type": "text", "id": "title", "label": "Page title", "default": "Shopping Cart" },
    { "type": "text", "id": "product_singular", "label": "\"Product\" count word (singular)", "default": "Product" },
    { "type": "text", "id": "product_plural", "label": "\"Product\" count word (plural)", "default": "Products" },
    { "type": "text", "id": "item_singular", "label": "\"Item\" count word (singular)", "default": "Item" },
    { "type": "text", "id": "item_plural", "label": "\"Item\" count word (plural)", "default": "Items" },
    { "type": "text", "id": "qty_label", "label": "Quantity field label", "default": "Quantity" },
    { "type": "text", "id": "amount_label", "label": "Line amount label", "default": "Amount:" },
    { "type": "text", "id": "save_for_later_label", "label": "Save-for-later button", "default": "Save for Later" },
    { "type": "text", "id": "remove_label", "label": "Remove button", "default": "Remove" },
    { "type": "text", "id": "summary_heading", "label": "Order summary heading", "default": "Order Summary" },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "subtotal_note", "label": "Subtotal fine print", "default": "Subtotal does not include shipping or tax" },
    { "type": "text", "id": "shipping_label", "label": "Shipping-estimate toggle label", "default": "Estimate Shipping" },
    { "type": "text", "id": "shipping_note", "label": "Shipping-estimate intro line", "default": "Ships to the contiguous U.S. only (excludes Alaska, Hawaii and Puerto Rico)." },
    { "type": "text", "id": "zip_label", "label": "Zip code field label", "default": "Zip / Postal Code" },
    { "type": "text", "id": "state_label", "label": "State field label", "default": "State" },
    { "type": "text", "id": "state_placeholder", "label": "State field placeholder", "default": "Select a state" },
    { "type": "text", "id": "shipping_button_label", "label": "Shipping-estimate button", "default": "Get Estimate" },
    { "type": "text", "id": "tax_note", "label": "Tax fine print", "default": "Tax is calculated at checkout." },
    { "type": "text", "id": "promo_label", "label": "Promo-code toggle label", "default": "Have a Promo Code?" },
    { "type": "text", "id": "promo_placeholder", "label": "Promo-code field placeholder", "default": "Enter code" },
    { "type": "text", "id": "promo_note", "label": "Promo-code fine print", "default": "Applied and verified at checkout." },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Proceed To Checkout" },
    { "type": "text", "id": "empty_message", "label": "Empty-cart message", "default": "Your cart is currently empty." },
    { "type": "text", "id": "continue_shopping_label", "label": "Empty-cart button", "default": "Continue Shopping" },
    { "type": "text", "id": "saved_heading", "label": "Saved-for-later heading", "default": "Saved For Later" },
    { "type": "text", "id": "recently_viewed_heading", "label": "Recently-viewed heading", "default": "Recently Viewed" }
  ]
}
{% endschema %}
