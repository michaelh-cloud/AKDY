{% comment %}
  Six image tiles on a four-column grid. Tiles marked "wide" span two
  columns (tiles 1 and 6 on the approved layout: 630x300 images).
{% endcomment %}
<section class="info-blocks">
  <div class="info-grid">
    {%- for block in section.blocks -%}
    {%- capture tile_media -%}
      {%- if block.settings.image -%}
        {{ block.settings.image | image_url: width: 1260 | image_tag: alt: block.settings.alt, loading: 'lazy' }}
      {%- else -%}
        <img src="{{ block.settings.image_url }}" alt="{{ block.settings.alt }}" width="{{ block.settings.image_width | default: 310 }}" height="{{ block.settings.image_height | default: 300 }}" loading="lazy">
      {%- endif -%}
    {%- endcapture -%}
    {%- if block.settings.link != blank -%}
      <a class="tile-media{% if block.settings.wide %} tile-wide{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ tile_media }}</a>
    {%- else -%}
      {% comment %} No link configured yet — plain, non-clickable wrapper. {% endcomment %}
      <div class="tile-media{% if block.settings.wide %} tile-wide{% endif %}" {{ block.shopify_attributes }}>{{ tile_media }}</div>
    {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Info grid",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Wide tiles: 630 x 300. Square tiles: 310 x 300. Overrides the external image URL below."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "External image URL",
          "info": "Used until an image is uploaded above."
        },
        {
          "type": "number",
          "id": "image_width",
          "label": "External image width (px)"
        },
        {
          "type": "number",
          "id": "image_height",
          "label": "External image height (px)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "wide",
          "label": "Wide tile (spans two columns)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info grid",
      "blocks": [
        { "type": "tile", "settings": { "wide": true } },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile", "settings": { "wide": true } }
      ]
    }
  ]
}
{% endschema %}
