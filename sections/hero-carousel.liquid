{% comment %}
  Hero carousel. Slide order here IS the display order (see PREVIEW-NOTES.md
  in the migration workspace for the slide-to-image mapping — the audit's
  media_refs order was misleading). akdy.js clones the first and last slides
  at runtime for the seamless loop, so this markup contains only real slides.
  A slide with no eyebrow and no heading renders image-only (slide 5, the
  tub-filler infographic, has its text baked into the image).
{% endcomment %}
<section class="hero" aria-roledescription="carousel" aria-label="Featured products">
  <div class="hero-track">
    {%- for block in section.blocks -%}
    <div class="hero-slide" {{ block.shopify_attributes }}>
      {%- capture hero_slide_media -%}
        {%- if block.settings.image -%}
          {{ block.settings.image | image_url: width: 2684 | image_tag: width: 1342, height: 600, alt: block.settings.alt }}
        {%- else -%}
          <img src="{{ block.settings.image_url }}" alt="{{ block.settings.alt }}" width="1342" height="600">
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ hero_slide_media }}</a>
      {%- else -%}
        {% comment %} No link configured yet — plain, non-clickable wrapper so the image doesn't look tappable with nowhere to go. {% endcomment %}
        <div class="hero-slide-media">{{ hero_slide_media }}</div>
      {%- endif -%}
      {%- if block.settings.eyebrow != blank or block.settings.heading != blank -%}
      <div class="hero-caption">
        {% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
        {% if block.settings.heading != blank %}<h2>{{ block.settings.heading }}</h2>{% endif %}
        {%- if block.settings.cta_label != blank -%}
          {%- if block.settings.link != blank -%}
            <a class="btn-green" href="{{ block.settings.link }}">{{ block.settings.cta_label }}</a>
          {%- else -%}
            <span class="btn-green" aria-disabled="true">{{ block.settings.cta_label }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
    {%- endfor -%}
  </div>
  <div class="hero-dots" role="group" aria-label="Choose slide">
    {%- for block in section.blocks -%}
    <button type="button" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span class="sr-only">{{ forloop.index }}</span></button>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero carousel",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "1342 x 600 recommended. Overrides the external image URL below."
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "External image URL",
          "info": "Used until an image is uploaded above. Move images to Shopify's CDN before launch."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow (italic line)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
